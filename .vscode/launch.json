{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Canon Keeper",
      "type": "debugpy",
      "request": "launch",
      "module": "canon_keeper",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Canon Keeper (scratch data)",
      "type": "debugpy",
      "request": "launch",
      "module": "canon_keeper",
      "args": ["-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "CANONKEEPER_DATA_DIR": "${workspaceFolder}/.canonkeeper"
      }
    },
    {
      "name": "Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
